    {
      "id": "addon-0-3-90-questing-alerts",
      "date": "2026-11-02",
      "area": "addon",
      "title": "Know who is on the same quest",
      "notes": [
        "A chat line when you meet a guildmate who shares your quests (/hmc alerts on or off).",
        "Quest tooltips list the guildmates on that quest and who is ready to turn it in."
