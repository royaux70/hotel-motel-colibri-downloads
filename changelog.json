    {
      "id": "addon-0-3-90-recipe-tooltips",
      "date": "2026-11-02",
      "area": "addon",
      "title": "See who knows a recipe",
      "notes": [
        "Your recipes are saved automatically when you open your profession window.",
        "Recipe, pattern and plans tooltips show which guildmates know it and who could learn it, and /hmc lists each crafter's recipes."
      ],
      "version": "0.3.90",
      "link": {
